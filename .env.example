# Hentai@Home Monitor Environment Variables

# --- Monitor Settings ---
# Check interval in minutes (default: 10)
CHECK_INTERVAL_MINUTES=10

# Toggle monitoring features (true/false)
CHECK_OFFICIAL=true
CHECK_RUST=true
CHECK_EHPAGE=true
CHECK_QUOTA=true
CHECK_CLIENTS=true

# E-Hentai Cookies (Required for ehpage, quota, and clients)
EH_IPB_MEMBER_ID=your_member_id
EH_IPB_PASS_HASH=your_pass_hash

# GitHub Token (Optional, to avoid API rate limits)
GITHUB_TOKEN=

# Proxy (Optional, e.g., http://127.0.0.1:7890)
PROXY=

# --- Notification Settings ---
# Notification language (zh, zh-hant, en, ja, ko, es, fr, ru, de, ar, he)
LANGUAGE=zh

# Notification Group Name
NOTIFY_GROUP=H@H

# Bark (iOS)
BARK_URL=
BARK_SOUND=minuet

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PushPlus
PUSHPLUS_TOKEN=

# PushDeer
PUSHDEER_KEY=

# DingTalk
DINGTALK_ACCESS_TOKEN=

# Discord
DISCORD_WEBHOOK=

# Slack
SLACK_WEBHOOK=

# Gotify
GOTIFY_URL=
GOTIFY_TOKEN=

# Matrix
MATRIX_URL=
MATRIX_TOKEN=
MATRIX_ROOM_ID=

# Pushover
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Webhooks (Comma-separated URLs)
WEBHOOKS=

# --- System Settings ---
# Custom database path (default: hath_monitor.db in script directory)
DB_PATH=
# Verify SSL certificates (default: false for compatibility)
VERIFY_SSL=false
